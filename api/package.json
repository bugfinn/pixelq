{
  "name": "@pixelq/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/server.ts",
    "db:check": "tsx --env-file=../.env src/db-check.ts",
    "db:generate": "drizzle-kit generate",
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "tsx --env-file=../.env src/migrate-cli.ts",
    "start": "node dist/server.js",
    "queue:check": "tsx --env-file=../.env src/queue-check.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.3",
    "bullmq": "^6.3.15",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
