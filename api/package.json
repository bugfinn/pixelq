{
  "name": "@pixelq/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/server.ts",
    "db:check": "tsx --env-file=../.env src/db-check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../.env src/migrate.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "queue:check": "tsx --env-file=../.env src/queue-check.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.3",
    "bullmq": "^6.3.15",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
